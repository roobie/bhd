{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "index.html!",
    "play.html!",
    "src/reporter/worker.ts!",
    // The deployed signalling Worker (wrangler), and the by-hand two-tab test.
    "worker/index.ts!",
    "test/net/two-tabs.e2e.ts"
  ],
  "project": ["src/**/*.ts!", "worker/**/*.ts!", "test/**/*.ts"],
  "ignoreIssues": {
    "src/reporter/types.ts": ["exports", "types"],
    "src/reporter/store.ts": ["exports"],
    "worker/room.ts": ["exports", "types"],
    "worker/turn.ts": ["exports", "types"]
  }
}
