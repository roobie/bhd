{
  "$schema": "./node_modules/knip/schema.json",
  "entry": ["index.html!", "play.html!", "src/reporter/worker.ts!"],
  "project": ["src/**/*.ts!", "worker/**/*.ts!", "test/**/*.ts"],
  "ignoreIssues": {
    "src/reporter/types.ts": ["exports", "types"],
    "src/reporter/store.ts": ["exports"],
    "src/content/bargains/pool.ts": ["exports"],
    "src/perception/types.ts": ["types"]
  }
}
